# Aegis Enterprise Console — Zero-Cost Environment Variables
# All core administration, authentication, RBAC, audit, and database features
# run on Cloudflare Workers + D1 SQLite (or local Node 22 SQLite) with zero paid secrets.

# APP_URL: Public URL where the console is hosted (optional in local dev).
APP_URL="http://localhost:3000"

# GITHUB_TOKEN: Optional server-side GitHub Personal Access Token for private repositories
# or higher rate limits in the GitHub & Developer Center module. Never expose to frontend.
GITHUB_TOKEN=""

# GITHUB_DEFAULT_REPO: Optional default owner/repo (e.g. "octocat/Hello-World")
GITHUB_DEFAULT_REPO=""

# GEMINI_API_KEY: Optional server-side key for the AI Security & Operations Advisor.
# Core admin features operate normally without it.
GEMINI_API_KEY=""

# EMAIL_PROVIDER_URL: Optional webhook/provider endpoint for outbound email notifications & password resets.
# When unset, password resets and email sends honestly report unconfigured provider status.
EMAIL_PROVIDER_URL=""

# PUSH_PROVIDER_URL: Optional webhook/provider endpoint for mobile/web push notifications.
# When unset, push notifications honestly report unconfigured provider status.
PUSH_PROVIDER_URL=""
